<Window x:Class="Calculator.Views.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator.Views"
        mc:Ignorable="d"
        Title="Инженерный калькулятор" Height="600" Width="350" Background="{DynamicResource ColorBg}">
    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
            <ColumnDefinition Width="1*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height="2.5*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
            <RowDefinition Height="2*"></RowDefinition>
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" Grid.ColumnSpan="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"></ColumnDefinition>
                <ColumnDefinition Width="1.5*"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" x:Name="ColorTheme" VerticalAlignment="Center" Margin="3, 0" SelectionChanged="ColorTheme_SelectionChanged">
                <ComboBoxItem Content="Белый+Синий"></ComboBoxItem>
                <ComboBoxItem Content="Фиолетовый+Бирюзовый"></ComboBoxItem>
                <ComboBoxItem Content="Черный+Розовый"></ComboBoxItem>
            </ComboBox>

            <TextBlock Grid.Column="1" Text="Перейти на:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="2" Foreground="{DynamicResource ColorMainText}" FontSize="13"></TextBlock>
            <Button Grid.Column="2" Content="Обычный" Margin="4" Padding="2" x:Name="BtnSwitchToBase" Style="{StaticResource ActBtnStyle}" FontSize="13" Click="BtnSwitchToBase_Click"></Button>
        </Grid>

        <TextBox x:Name="HistOutput" Grid.Row="1" Grid.ColumnSpan="4" TextAlignment="Right" 
         VerticalContentAlignment="Bottom" BorderThickness="0" IsReadOnly="True" 
         Focusable="False" Style="{StaticResource HistOutputTB}"></TextBox>

        <TextBox x:Name="MainOutput" Text="0" Grid.Row="2" Grid.ColumnSpan="4" TextAlignment="Right" 
         VerticalContentAlignment="Center" BorderThickness="0" 
         IsReadOnly="True" Focusable="False" Style="{StaticResource MainOutputTB}"></TextBox>

        <Button Content="History" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Hist_Click"></Button>
        <Button Content="C"  Grid.Row="3" Grid.Column="2" Margin="2" Style="{StaticResource ActBtnStyle}" Click="C_Click"></Button>
        <Button Content="BS" Grid.Row="3" Grid.Column="3" Margin="2" Style="{StaticResource ActBtnStyle}" Click="BS_Click"></Button>

        <Button Content="sin" Grid.Row="4" Grid.Column="0" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>
        <Button Content="cos" Grid.Row="4" Grid.Column="1" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>
        <Button Content="tg"  Grid.Row="4" Grid.Column="2" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>
        <Button Content="ctg" Grid.Row="4" Grid.Column="3" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>

        <Button Content="7" Grid.Row="5" Grid.Column="0" Margin="2" Style="{StaticResource NumBtnStyle}" Click="Digit_Click"></Button>
        <Button Content="8" Grid.Row="5" Grid.Column="1" Margin="2" Style="{StaticResource NumBtnStyle}" Click="Digit_Click"></Button>
        <Button Content="9" Grid.Row="5" Grid.Column="2" Margin="2" Style="{StaticResource NumBtnStyle}" Click="Digit_Click"></Button>
        <Button Content="/" Grid.Row="5" Grid.Column="3" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Op_Click"></Button>

        <Button Content="4" Grid.Row="6" Grid.Column="0" Margin="2" Style="{StaticResource NumBtnStyle}" Click="Digit_Click"></Button>
        <Button Content="5" Grid.Row="6" Grid.Column="1" Margin="2" Style="{StaticResource NumBtnStyle}" Click="Digit_Click"></Button>
        <Button Content="6" Grid.Row="6" Grid.Column="2" Margin="2" Style="{StaticResource NumBtnStyle}" Click="Digit_Click"></Button>
        <Button Content="*" Grid.Row="6" Grid.Column="3" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Op_Click"></Button>

        <Button Content="1" Grid.Row="7" Grid.Column="0" Margin="2" Style="{StaticResource NumBtnStyle}" Click="Digit_Click"></Button>
        <Button Content="2" Grid.Row="7" Grid.Column="1" Margin="2" Style="{StaticResource NumBtnStyle}" Click="Digit_Click"></Button>
        <Button Content="3" Grid.Row="7" Grid.Column="2" Margin="2" Style="{StaticResource NumBtnStyle}" Click="Digit_Click"></Button>
        <Button Content="-" Grid.Row="7" Grid.Column="3" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Op_Click"></Button>

        <Button Content="+/-" Grid.Row="8" Grid.Column="0" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Negate_Click"></Button>
        <Button Content="0"   Grid.Row="8" Grid.Column="1" Margin="2" Style="{StaticResource NumBtnStyle}" Click="Digit_Click"></Button>
        <Button Content=","   Grid.Row="8" Grid.Column="2" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Comma_Click"></Button>
        <Button Content="+"   Grid.Row="8" Grid.Column="3" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Op_Click"></Button>

        <Button Content="%"    Grid.Row="9" Grid.Column="0" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>
        <Button Content="sqrt" Grid.Row="9" Grid.Column="1" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>
        <Button Content="x^n"  Grid.Row="9" Grid.Column="2" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>
        <Button Content="1/x"  Grid.Row="9" Grid.Column="3" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>

        <Button Content="log" Grid.Row="10" Grid.Column="0" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>
        <Button Content="ln"  Grid.Row="10" Grid.Column="1" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>
        <Button Content="x!"  Grid.Row="10" Grid.Column="2" Margin="2" Style="{StaticResource ActBtnStyle}" Click="Sci_Click"></Button>
        <Button Content="="   Grid.Row="10" Grid.Column="3" Margin="2" Style="{StaticResource EqBtnStyle}"  Click="Eq_Click"></Button>
    </Grid>
</Window>